<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .main-content {
      flex: 1 0 auto;
    }
    .footer {
      flex-shrink: 0;
      background: #1e293b;
      color: #e2e8f0;
      border-top: 3px solid #3b82f6;
    }
    .badge-vat {
      background-color: #ef4444;
      font-size: 0.85rem;
    }
    .card-header-custom {
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      color: white;
    }
    .session-badge {
      background: #e0e7ff;
      color: #3730a3;
      font-family: monospace;
      padding: 4px 8px;
      border-radius: 6px;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="bi bi-book-half text-primary me-2"></i>Hệ thống Quản lý Sách
      </a>
      <span class="navbar-text text-light">
        <span class="badge bg-primary">Cloud Computing</span>
        <span class="badge bg-success ms-1">Stateless Architecture</span>
      </span>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="main-content container py-4">
    {{{body}}}
  </main>

  <!-- Footer bắt buộc theo yêu cầu đề bài -->
  <footer class="footer py-3 mt-4">
    <div class="container text-center">
      <div class="row align-items-center">
        <div class="col-md-12">
          <p class="mb-1 fw-bold fs-6 text-uppercase text-info">
            <i class="bi bi-person-badge me-1"></i>
            Họ và tên: <span class="text-white">{{studentInfo.name}}</span> &nbsp;|&nbsp;
            MSSV: <span class="text-warning">{{studentInfo.studentId}}</span> &nbsp;|&nbsp;
            Mức VAT áp dụng: <span class="badge bg-danger fs-6">{{studentInfo.vatRate}}%</span>
          </p>
          <small class="text-secondary">
            Đề kiểm tra Giữa kì - Môn Điện toán đám mây &copy; 2026. Thiết kế hạ tầng phân tán &amp; Bảo mật Least Privilege trên MongoDB Atlas.
          </small>
        </div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
